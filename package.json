{
  "name": "@maxwellmezadre/mercadolivre-mcp",
  "version": "0.2.0",
  "description": "CLI + servidor MCP para o histórico de compras do Mercado Livre (compras, produtos, preços, parcelamento, vendedores e notas fiscais) sobre um núcleo compartilhado",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwellmezadre/mercadolivre-mcp.git"
  },
  "homepage": "https://github.com/maxwellmezadre/mercadolivre-mcp#readme",
  "keywords": ["mercadolivre", "mercadolibre", "cli", "mcp", "purchases", "orders", "nfe", "invoices", "claude"],
  "bin": {
    "mercadolivre": "dist/bin.js",
    "mercadolivre-mcp": "dist/mcp-bin.js"
  },
  "files": ["dist", "SKILL.md", "docs/TOOLS.md", "README.md", "LICENSE"],
  "exports": "./dist/bin.js",
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.3" },
  "scripts": {
    "start": "bun run src/bin.ts",
    "login": "bun run src/bin.ts login",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run scripts/verify.ts",
    "docs:tools": "bun run scripts/gen-tools-doc.ts",
    "build:dist": "bun build src/bin.ts src/mcp-bin.ts --target=bun --packages external --outdir dist",
    "build:binary": "bun build --compile --external chromium-bidi src/bin.ts --outfile mercadolivre",
    "prepublishOnly": "bun run build:dist",
    "setup": "bun run scripts/install.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "commander": "^15.0.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^5"
  }
}
